{
  "title": "华强买瓜 2026 · 赛博保熟版",
  "speakers": {
    "huaqiang": {
      "voice": "zh-CN-YunjianNeural",
      "rate": "+4%",
      "pitch": "-3Hz"
    },
    "robot": {
      "voice": "zh-CN-YunyangNeural",
      "rate": "+6%",
      "pitch": "+2Hz",
      "fx": "robot"
    }
  },
  "lineGap": 0.32,
  "scenes": [
    {
      "id": "title",
      "lead": 1.4,
      "tail": 0.9,
      "lines": [
        {
          "who": "robot",
          "text": "华强买瓜，二零二六赛博保熟版，启动！"
        }
      ]
    },
    {
      "id": "arrive",
      "lead": 2.2,
      "tail": 0.6,
      "lines": [
        {
          "who": "huaqiang",
          "text": "哥们儿，这瓜多少钱一斤？",
          "danmu": [
            "前方名场面！",
            "经典开局"
          ]
        },
        {
          "who": "robot",
          "text": "您好，本摊由龙虾智能体托管。两块钱一斤，词元另算。",
          "caption": "词元另算",
          "danmu": [
            "养龙虾养到瓜摊了",
            "词元另算是什么鬼",
            "AI：我也要恰饭"
          ]
        }
      ]
    },
    {
      "id": "price",
      "lead": 0.3,
      "tail": 0.9,
      "lines": [
        {
          "who": "huaqiang",
          "text": "What's up！这瓜皮子是金子做的，还是瓜粒子是金子做的？",
          "danmu": [
            "What's up！",
            "原声复刻"
          ]
        },
        {
          "who": "robot",
          "text": "都不是，是算力做的。",
          "caption": "算力瓜",
          "danmu": [
            "难怪内存这么贵",
            "一口一个显卡",
            "算力瓜 绝绝子"
          ]
        }
      ]
    },
    {
      "id": "ripe",
      "lead": 0.3,
      "tail": 1.0,
      "lines": [
        {
          "who": "huaqiang",
          "text": "你这瓜保熟吗？"
        },
        {
          "who": "robot",
          "text": "我开瓜摊的，能卖给你生瓜蛋子？AI鉴定，保熟率百分之九十九点九。",
          "danmu": [
            "99.9%？",
            "这数字怎么这么眼熟"
          ]
        },
        {
          "who": "huaqiang",
          "text": "那剩下的零点一呢？"
        },
        {
          "who": "robot",
          "text": "那是幻觉。",
          "caption": "AI幻觉",
          "danmu": [
            "哈哈哈哈哈幻觉",
            "大模型都这么说",
            "根本就没有这样的瓜摊",
            "你只是怕了"
          ]
        }
      ]
    },
    {
      "id": "scale",
      "lead": 0.3,
      "tail": 1.0,
      "lines": [
        {
          "who": "huaqiang",
          "text": "给我挑一个。"
        },
        {
          "who": "robot",
          "text": "这个十五斤，您拿好。"
        },
        {
          "who": "huaqiang",
          "text": "你这哪够十五斤？你这秤有问题啊！",
          "danmu": [
            "来了来了",
            "吸铁石呢？"
          ]
        },
        {
          "who": "robot",
          "text": "我这不叫缺斤少两，我这叫显化。",
          "caption": "显化十五斤",
          "danmu": [
            "显化学会了",
            "假装够秤 直到真的够秤",
            "秤：我开美颜了"
          ]
        }
      ]
    },
    {
      "id": "cut",
      "lead": 0.3,
      "tail": 0.8,
      "lines": [
        {
          "who": "robot",
          "text": "你故意找茬是不是？你要不要吧！"
        },
        {
          "who": "huaqiang",
          "text": "你这瓜要是熟，我肯定要啊。"
        },
        {
          "who": "robot",
          "text": "行，我给你开一个。",
          "danmu": [
            "前方高能",
            "刀下留瓜"
          ],
          "beat": 1.6
        },
        {
          "who": "huaqiang",
          "text": "等等，这瓜怎么越切越长？"
        },
        {
          "who": "robot",
          "text": "超长长长长长时代，瓜也得卷长度。",
          "caption": "超长长长长长瓜",
          "danmu": [
            "超长蛋挞：我先来的",
            "瓜：我卷不动了",
            "这瓜能跳绳了"
          ]
        }
      ]
    },
    {
      "id": "dance",
      "lead": 0.3,
      "tail": 2.2,
      "lines": [
        {
          "who": "robot",
          "text": "为了庆祝保熟，来段闪身步！",
          "danmu": [
            "闪身步！",
            "膝盖：谢谢你",
            "骨科医生已就位"
          ],
          "beat": 4.2
        },
        {
          "who": "huaqiang",
          "text": "浪子踢球，接住！",
          "caption": "浪子踢球",
          "danmu": [
            "这脚法 国足看了都说好",
            "瓜飞了！！"
          ]
        }
      ]
    },
    {
      "id": "tour",
      "lead": 1.2,
      "tail": 2.0,
      "lines": [
        {
          "who": "robot",
          "text": "华强买瓜世界巡演，现在开始！",
          "caption": "世界巡演",
          "danmu": [
            "世界巡演又来了",
            "台下全是瓜"
          ],
          "beat": 3.6
        },
        {
          "who": "huaqiang",
          "text": "这瓜，保熟！",
          "danmu": [
            "一个瓜激动晕倒被抬走了",
            "下一站：吐鲁番",
            "保熟！保熟！"
          ]
        }
      ]
    },
    {
      "id": "outro",
      "lead": 0.4,
      "tail": 3.4,
      "lines": [
        {
          "who": "robot",
          "text": "感谢光临。爱你老己，明天见！",
          "danmu": [
            "爱你老己",
            "老瓜明天见"
          ]
        },
        {
          "who": "huaqiang",
          "text": "下回买瓜，还来你这儿。"
        }
      ]
    }
  ]
}
